# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# glm-hammer
.glm-hammer/

# claude code
# .claude/ 아래는 기본 무시하되, 저장소로 공유하는 subagent(검증 루프)만 추적한다
.claude/*
!.claude/agents/

# prisma (runtime artifacts)
generated/
dev.db
dev.db-journal
prisma/dev.db
test.db
test.db-journal
